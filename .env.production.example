# Production frontend environment
# Point this to your deployed backend API domain.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/

# Production does not use Next.js dev origins, so leave this unset.

# Shared help service (AppHelpCenter). Leave blank to show no Help icon.
# Set it to the help service address, such as https://help.example.com
NEXT_PUBLIC_HELP_URL=
