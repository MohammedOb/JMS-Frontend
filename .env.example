# Development frontend environment
# Copy this file to .env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:5000/

# Optional: allow opening the Next.js dev server from LAN/IP addresses.
# Example:
# NEXT_ALLOWED_DEV_ORIGINS=http://192.168.29.62:3000
NEXT_ALLOWED_DEV_ORIGINS=

# Shared help service (AppHelpCenter). Leave blank to show no Help icon.
# Set it to the help service address, such as https://help.example.com
NEXT_PUBLIC_HELP_URL=
